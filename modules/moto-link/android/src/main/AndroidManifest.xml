<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Dash link: listeners on 10920-10922 and the probe to dash:10930. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- requestNetwork() with a WifiNetworkSpecifier (joinWifi). -->
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

  <!-- Keep-alive service (type connectedDevice) and screen mirroring (type mediaProjection). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

  <!-- "Bike connected" notification and the services' ongoing notifications (Android 13+). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Volume re-pin for the handlebar rocker. -->
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

  <application>
    <service
      android:name="expo.modules.motolink.LinkService"
      android:exported="false"
      android:foregroundServiceType="connectedDevice" />
    <service
      android:name="expo.modules.motolink.MirrorService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />
  </application>
</manifest>
